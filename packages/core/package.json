{
  "name": "@portablesheep/brevity",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators.d.ts",
      "default": "./dist/decorators.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortableSheep/brevity.git",
    "directory": "packages/core"
  },
  "homepage": "https://portablesheep.github.io/brevity/",
  "bugs": {
    "url": "https://github.com/PortableSheep/brevity/issues"
  },
  "description": "Lightweight Node HTTP routing, explicit DI, and optional TypeScript decorators"
}
