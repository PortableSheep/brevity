{
  "name": "@portablesheep/brevity-islands",
  "version": "0.1.0",
  "description": "Optional HTML-first native islands and progressive forms",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./loader.js": "./dist/loader.js",
    "./enhance.js": "./dist/enhance.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-islands.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@portablesheep/brevity-web": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortableSheep/brevity.git",
    "directory": "packages/islands"
  },
  "homepage": "https://portablesheep.github.io/brevity/",
  "bugs": {
    "url": "https://github.com/PortableSheep/brevity/issues"
  }
}
