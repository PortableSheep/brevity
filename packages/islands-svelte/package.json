    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": { "@brevity/islands": "^0.1.0", "svelte": "^5.0.0" },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
