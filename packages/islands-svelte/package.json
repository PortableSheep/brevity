{
  "name": "@brevity/islands-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 adapter for @brevity/islands",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
