{
  "name": "support-inbox-proof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "start:brevity": "node dist/brevity.js",
    "start:express": "node dist/express.js",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@brevity/core": "file:../../packages/core",
    "@brevity/web": "file:../../packages/web",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.17.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
